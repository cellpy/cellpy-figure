{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cellpy/cellpy-figure/schema/figure-1.json",
  "title": "cellpy-figure format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["panels", "provenance"],
  "properties": {
    "title": { "type": "string" },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/panel" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "created"],
      "properties": {
        "format": { "const": "cellpy-figure" },
        "format_version": { "const": 1 },
        "created": { "type": "string", "minLength": 1 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/encoding" },
        "y": { "$ref": "#/$defs/encoding" },
        "color": { "$ref": "#/$defs/encoding" },
        "stroke": { "$ref": "#/$defs/encoding" },
        "facet": { "$ref": "#/$defs/encoding" }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "type": { "enum": ["nominal", "quantitative"] },
        "legend_title": { "type": "string" },
        "scale": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_version"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "producer_version": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "source": { "type": "string" }
      }
    }
  }
}
